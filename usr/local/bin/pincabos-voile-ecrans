#!/usr/bin/env python3
"""Voile sur chaque ecran entre l arrivee de X et le premier rendu du frontend.

PINCABOS_VOILE_ECRANS_V1

Chromium peint ses fenetres en blanc avant son premier rendu : dans le noir du
cab, le playfield 4K « fusille les yeux » a chaque lancement (mesure sur le
cab de Yann : un cliche entierement blanc 3 s apres le lancement du service,
avec ou sans mode sombre force). Ce voile est une fenetre X override-redirect
par ecran de screens.json, maintenue au-dessus de tout (XRaiseWindow a
50 Hz : une fenetre Chromium qui apparait passe dessous en moins de 20 ms),
retiree `--delai` secondes apres l apparition d une NOUVELLE fenetre
« VPinFE Table » (xdotool ; celles d avant un redemarrage ne comptent pas), ou au plus tard a `--max` secondes. Jamais bloquant : sans X, sans
libX11 ou sans screens.json, on couvre l ecran entier ou on sort.

PINCABOS_VOILE_VISUELS_V4 (Yann, 08/09/2026, apres une installation complete) :
le voile REPREND les visuels du splash, et c est le defaut.

Il etait passe au noir la veille (V3) parce que les visuels « clignotaient » —
mais ce clignotement venait du sens de rotation inverse (PINCABOS_VOILE_SENS_V2,
corrige depuis) : le voile rejouait l image du splash tete en bas. Une fois les
deux chemins alignes, le voile affiche EXACTEMENT ce que Plymouth affichait, et
le raccord ne se voit plus du tout.

Le noir, lui, se voyait : mesure sur le cab de Yann, 8,5 s d ecran noir entre
la fin du splash et le premier rendu du frontend — « j ai eu un ecran noir
pendant plusieurs secondes ». --noir rend ce comportement a qui le veut.

Le fondu : sans compositeur (aucun sur un pincab, et en lancer un couterait de
la latence en jeu), l opacite d une fenetre X n existe pas. On passe donc par la
rampe de gamma de l ecran (XF86VidMode), qui s applique a TOUT ce que la sortie
affiche, voile retire compris : on descend a zero, on retire le voile, on remonte.
Ce que le spectateur voit, c est VPinFE qui apparait en fondu. La rampe est
restauree quoi qu il arrive (fin normale, exception, SIGTERM de systemd) : un
ecran laisse a zero serait une panne noire.

PINCABOS_VOILE_VISUELS_V1 (--visuels) : chaque ecran recoit le visuel de la
galerie qui lui revient (portrait sur le playfield, paysage ailleurs, memes
images que Plymouth : /opt/pincabos/media/splash), decode par GdkPixbuf et pose
en fond de fenetre (pixmap X : le serveur repeint seul). Le playfield d une dalle
paysage recoit le portrait tourne de 270 dans le MEME sens que le splash
(PINCABOS_VOILE_SENS_V2 : l enumeration GdkPixbuf compte en anti-horaire, ffmpeg
en horaire). Sans GdkPixbuf ou sans visuel, le voile reste noir : rien ne bloque.

  pincabos-voile-ecrans [--delai 3.5] [--max 40] [--fenetre "VPinFE Table"]
                        [--visuels] [--fondu 0.45]
"""
from __future__ import annotations

import argparse
import ctypes
import json
import os
import random
import re
import signal
import subprocess
import sys
import time

SCREENS = "/opt/pincabos/config/screens/screens.json"
GALERIE = "/opt/pincabos/media/splash"
ROLES = ("playfield", "backglass", "fulldmd", "topper")
GEOMETRIE = re.compile(r"^(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$")
CW_OVERRIDE_REDIRECT = 1 << 9
ZPIXMAP = 2


class XSetWindowAttributes(ctypes.Structure):
    _fields_ = [
        ("background_pixmap", ctypes.c_ulong), ("background_pixel", ctypes.c_ulong),
        ("border_pixmap", ctypes.c_ulong), ("border_pixel", ctypes.c_ulong),
        ("bit_gravity", ctypes.c_int), ("win_gravity", ctypes.c_int), ("backing_store", ctypes.c_int),
        ("backing_planes", ctypes.c_ulong), ("backing_pixel", ctypes.c_ulong), ("save_under", ctypes.c_int),
        ("event_mask", ctypes.c_long), ("do_not_propagate_mask", ctypes.c_long),
        ("override_redirect", ctypes.c_int), ("colormap", ctypes.c_ulong), ("cursor", ctypes.c_ulong),
    ]


def geometries(texte: str | None) -> list:
    """[(role, x, y, w, h)] des ecrans de screens.json (geometrie logique, apres xrandr)."""
    if not texte:
        return []
    try:
        data = json.loads(texte)
    except ValueError:
        return []
    out = []
    for role in ROLES:
        e = data.get(role)
        if not isinstance(e, dict):
            continue
        m = GEOMETRIE.match(str(e.get("geometry") or ""))
        if m:
            w, h, x, y = (int(v) for v in m.groups())
            if w > 0 and h > 0:
                out.append((role, x, y, w, h))
    return out


def genre_visuel(role: str, w: int, h: int) -> tuple:
    """(genre de la source, rotation a lui appliquer) pour une dalle de geometrie X (w, h).

    Playfield sur une dalle paysage : portrait tourne de 270 (haut de table a gauche,
    PINCABOS_SPLASH_SENS_JOUEUR_V1) ; playfield deja portrait dans l espace X (dalle
    tournee par xrandr) : portrait droit ; autres dalles : paysage droit, ou portrait
    droit si la dalle est montee en portrait."""
    if role == "playfield":
        return ("portrait", 270) if w >= h else ("portrait", 0)
    return ("paysage", 0) if w >= h else ("portrait", 0)


def sources(genre: str, galerie: str = GALERIE) -> list:
    import glob
    return sorted(p for p in glob.glob(os.path.join(galerie, genre + "*"))
                  if p.lower().endswith((".png", ".jpg", ".jpeg")))


def bgrx(pixels: bytes, largeur: int, hauteur: int, rowstride: int, canaux: int) -> bytearray:
    """Pixels GdkPixbuf (RGB ou RGBA, lignes de `rowstride` octets) -> BGRX 32 bits,
    format ZPixmap d un serveur X 24 bits petit-boutiste."""
    out = bytearray(largeur * hauteur * 4)
    vue = memoryview(out)
    for y in range(hauteur):
        ligne = pixels[y * rowstride:y * rowstride + largeur * canaux]
        dest = vue[y * largeur * 4:(y + 1) * largeur * 4]
        dest[2::4] = ligne[0::canaux]
        dest[1::4] = ligne[1::canaux]
        dest[0::4] = ligne[2::canaux]
    return out


def composer(chemin: str, rotation: int, w: int, h: int):
    """Pixbuf RGB w x h : le visuel tourne puis ajuste (bandes noires), centre."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
    pb = GdkPixbuf.Pixbuf.new_from_file(chemin)
    # PINCABOS_VOILE_SENS_V2 (cab de Yann, 07/09/2026)
    # Piege : la valeur de l enumeration GdkPixbuf EST l angle ANTI-horaire.
    # CLOCKWISE vaut donc 270 anti-horaire, soit 90 horaire — l inverse de ce que
    # le splash fait pour la meme consigne (ffmpeg transpose=2 = 90 anti-horaire).
    # Les deux annoncaient « 270 » et tournaient a l oppose : le visuel du voile
    # arrivait tete en bas juste apres un splash correct.
    if rotation == 270:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.COUNTERCLOCKWISE)
    elif rotation == 90:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.CLOCKWISE)
    elif rotation == 180:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.UPSIDEDOWN)
    echelle = min(w / pb.get_width(), h / pb.get_height())
    sw, sh = max(1, round(pb.get_width() * echelle)), max(1, round(pb.get_height() * echelle))
    petit = pb.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
    fond = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h)
    fond.fill(0x000000FF)
    petit.copy_area(0, 0, sw, sh, fond, (w - sw) // 2, (h - sh) // 2)
    return fond


def fenetres_nommees(nom: str) -> set:
    """Identifiants X des fenetres portant ce nom (xdotool)."""
    try:
        r = subprocess.run(["xdotool", "search", "--name", nom], capture_output=True, text=True, timeout=3)
        return set(r.stdout.split()) if r.returncode == 0 else set()
    except (OSError, subprocess.SubprocessError):
        return set()


def nouvelle_fenetre(avant: set, maintenant: set) -> bool:
    """Une fenetre du frontend qui n existait pas au depart (un redemarrage du
    frontend laisse l ancienne quelques instants : elle ne compte pas)."""
    return bool(maintenant - avant)


def x11():
    lib = ctypes.CDLL("libX11.so.6")
    lib.XOpenDisplay.restype = ctypes.c_void_p
    lib.XOpenDisplay.argtypes = [ctypes.c_char_p]
    lib.XDefaultScreen.argtypes = [ctypes.c_void_p]
    lib.XDefaultRootWindow.restype = ctypes.c_ulong
    lib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    lib.XBlackPixel.restype = ctypes.c_ulong
    lib.XBlackPixel.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.XDefaultDepth.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.XDefaultVisual.restype = ctypes.c_void_p
    lib.XDefaultVisual.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.XCreateSimpleWindow.restype = ctypes.c_ulong
    lib.XCreateSimpleWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int,
                                        ctypes.c_uint, ctypes.c_uint, ctypes.c_uint, ctypes.c_ulong, ctypes.c_ulong]
    lib.XChangeWindowAttributes.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.POINTER(XSetWindowAttributes)]
    lib.XCreatePixmap.restype = ctypes.c_ulong
    lib.XCreatePixmap.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint]
    lib.XFreePixmap.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    lib.XCreateGC.restype = ctypes.c_void_p
    lib.XCreateGC.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p]
    lib.XFreeGC.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    lib.XCreateImage.restype = ctypes.c_void_p
    lib.XCreateImage.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_int,
                                 ctypes.c_char_p, ctypes.c_uint, ctypes.c_uint, ctypes.c_int, ctypes.c_int]
    lib.XPutImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p,
                              ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint]
    lib.XSetWindowBackgroundPixmap.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong]
    lib.XClearWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    for f in ("XMapRaised", "XRaiseWindow", "XUnmapWindow", "XDestroyWindow"):
        getattr(lib, f).argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    lib.XFlush.argtypes = [ctypes.c_void_p]
    lib.XCloseDisplay.argtypes = [ctypes.c_void_p]
    return lib


def rampe(taille: int, facteur: float) -> list:
    """Rampe de gamma lineaire mise a l echelle : 0 = noir, 1 = image normale.

    Sortie en 16 bits, taille imposee par le serveur (2048 sur le cab de Yann).
    """
    if taille < 2:
        return []
    facteur = max(0.0, min(1.0, facteur))
    haut = taille - 1
    return [max(0, min(65535, int(65535 * (i / haut) * facteur))) for i in range(taille)]


class Fondu:
    """Fondu de l ecran par la rampe de gamma (PINCABOS_VOILE_NOIR_V3).

    Facteur 0 = noir, 1 = image normale. Inoperant et silencieux si la
    bibliotheque ou l extension manquent : le voile se retire sec, comme avant.
    """

    def __init__(self, dpy):
        self.dpy, self.taille, self.vm, self.pose = dpy, 0, None, False
        try:
            vm = ctypes.CDLL("libXxf86vm.so.1")
        except OSError as exc:
            print(f"voile : pas de fondu ({exc})")
            return
        vm.XF86VidModeGetGammaRampSize.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
        vm.XF86VidModeSetGammaRamp.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
                                               ctypes.POINTER(ctypes.c_ushort), ctypes.POINTER(ctypes.c_ushort),
                                               ctypes.POINTER(ctypes.c_ushort)]
        taille = ctypes.c_int(0)
        if not vm.XF86VidModeGetGammaRampSize(ctypes.c_void_p(dpy), 0, ctypes.byref(taille)) \
                or taille.value <= 1:
            print("voile : pas de fondu (rampe de gamma indisponible)")
            return
        self.vm, self.taille = vm, taille.value

    def disponible(self) -> bool:
        return self.vm is not None

    def poser(self, facteur: float) -> None:
        if self.vm is None:
            return
        n = self.taille
        valeurs = rampe(n, facteur)
        canaux = [(ctypes.c_ushort * n)(*valeurs) for _ in range(3)]
        self.vm.XF86VidModeSetGammaRamp(ctypes.c_void_p(self.dpy), 0, n, *canaux)
        self.pose = facteur < 1.0

    def restaurer(self) -> None:
        """Toujours appelee : un ecran laisse a zero serait une panne noire."""
        if self.vm is not None and self.pose:
            try:
                self.poser(1.0)
            except Exception:
                pass


def habiller(lib, dpy, ecran, win, role: str, w: int, h: int, hasard: random.Random, gardes: list) -> str:
    """Pose le visuel en fond de la fenetre ; renvoie le nom du visuel, ou '' (voile noir)."""
    if lib.XDefaultDepth(dpy, ecran) != 24:
        return ""
    genre, rotation = genre_visuel(role, w, h)
    choix = sources(genre)
    if not choix:
        return ""
    chemin = hasard.choice(choix)
    try:
        pb = composer(chemin, rotation, w, h)
        donnees = bgrx(bytes(pb.get_pixels()), w, h, pb.get_rowstride(), pb.get_n_channels())
    except Exception as exc:   # GdkPixbuf absent ou image illisible : voile noir
        print(f"voile : visuel {os.path.basename(chemin)} non pose ({exc})")
        return ""
    tampon = ctypes.create_string_buffer(bytes(donnees), len(donnees))
    gardes.append(tampon)                                    # XCreateImage garde le pointeur
    image = lib.XCreateImage(dpy, lib.XDefaultVisual(dpy, ecran), 24, ZPIXMAP, 0, tampon, w, h, 32, 0)
    if not image:
        return ""
    pixmap = lib.XCreatePixmap(dpy, win, w, h, 24)
    gc = lib.XCreateGC(dpy, pixmap, 0, None)
    lib.XPutImage(dpy, pixmap, gc, image, 0, 0, 0, 0, w, h)
    lib.XFreeGC(dpy, gc)
    lib.XSetWindowBackgroundPixmap(dpy, win, pixmap)
    lib.XClearWindow(dpy, win)
    lib.XFreePixmap(dpy, pixmap)                             # le fond garde sa reference
    return os.path.basename(chemin)


def main(argv) -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--delai", type=float, default=3.5, help="secondes entre la fenetre du frontend et le retrait")
    p.add_argument("--max", type=float, default=40.0, help="duree maximale du voile")
    p.add_argument("--fenetre", default="VPinFE Table")
    # PINCABOS_VOILE_VISUELS_V4 : les visuels par defaut. --visuels reste accepte
    # (il ne fait plus rien) pour ne pas casser une unite qui le passe encore.
    p.add_argument("--noir", action="store_true", help="voile noir, sans visuel")
    p.add_argument("--visuels", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--fondu", type=float, default=0.45,
                   help="duree du fondu vers le frontend, en secondes (0 = retrait sec)")
    a = p.parse_args(argv[1:])

    try:
        lib = x11()
    except OSError as exc:
        print(f"voile : libX11 absente ({exc}), rien a faire")
        return 0
    # lightdm ecrit le cookie de la session (XAUTHORITY) un peu apres avoir lance X :
    # sans lui, libX11 refuse la connexion en le disant bruyamment. On l attend.
    xauth = os.environ.get("XAUTHORITY", "")
    for _ in range(100):
        if not xauth or (os.path.isfile(xauth) and os.path.getsize(xauth) > 0):
            break
        time.sleep(0.2)
    dpy = None
    for _ in range(100):                       # X peut arriver quelques secondes apres nous
        dpy = lib.XOpenDisplay(None)
        if dpy:
            break
        time.sleep(0.2)
    if not dpy:
        print("voile : pas de serveur X, rien a faire")
        return 0
    ecran = lib.XDefaultScreen(dpy)
    racine = lib.XDefaultRootWindow(dpy)
    noir = lib.XBlackPixel(dpy, ecran)
    try:
        with open(SCREENS, encoding="utf-8") as f:
            geos = geometries(f.read())
    except OSError:
        geos = []
    if not geos:
        geos = [("playfield", 0, 0, lib.XDisplayWidth(dpy, ecran), lib.XDisplayHeight(dpy, ecran))]

    attrs = XSetWindowAttributes()
    attrs.override_redirect = 1
    fenetres = []
    gardes = []
    hasard = random.Random()
    visuels = []
    for (role, x, y, w, h) in geos:
        win = lib.XCreateSimpleWindow(dpy, racine, x, y, w, h, 0, noir, noir)
        lib.XChangeWindowAttributes(dpy, win, CW_OVERRIDE_REDIRECT, ctypes.byref(attrs))
        if not a.noir:
            visuels.append(habiller(lib, dpy, ecran, win, role, w, h, hasard, gardes) or "noir")
        lib.XMapRaised(dpy, win)
        fenetres.append(win)
    lib.XFlush(dpy)
    print(f"voile : {len(fenetres)} ecran(s) couvert(s) {[(g[1], g[2], g[3], g[4]) for g in geos]} visuels {visuels}")

    fondu = Fondu(dpy)
    # Le voile couvre : quoi qu il arrive ensuite, la rampe revient a 1.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: (fondu.restaurer(), sys.exit(0)))

    debut = time.monotonic()
    vue = None
    prochain_test = 0.0
    initiales = fenetres_nommees(a.fenetre)
    while True:
        for win in fenetres:
            lib.XRaiseWindow(dpy, win)
        lib.XFlush(dpy)
        maintenant = time.monotonic()
        if vue is None and maintenant >= prochain_test:
            prochain_test = maintenant + 0.25
            if nouvelle_fenetre(initiales, fenetres_nommees(a.fenetre)):
                vue = maintenant
                print(f"voile : fenetre « {a.fenetre} » vue a {maintenant - debut:.1f} s, retrait dans {a.delai} s")
        if (vue is not None and maintenant - vue >= a.delai) or maintenant - debut >= a.max:
            break
        time.sleep(0.02)
    # Ecran a zero pendant que le voile couvre encore : rien ne bouge a l ecran.
    # On retire le voile derriere ce noir, puis on remonte : le frontend apparait.
    etapes = max(1, int(a.fondu / 0.015)) if a.fondu > 0 and fondu.disponible() else 0
    try:
        if etapes:
            fondu.poser(0.0)
            lib.XFlush(dpy)
        for win in fenetres:
            lib.XUnmapWindow(dpy, win)
            lib.XDestroyWindow(dpy, win)
        lib.XFlush(dpy)
        for i in range(1, etapes + 1):
            fondu.poser(i / etapes)
            time.sleep(a.fondu / etapes)
    finally:
        fondu.restaurer()
    lib.XFlush(dpy)
    lib.XCloseDisplay(dpy)
    print(f"voile : retire a {time.monotonic() - debut:.1f} s"
          + (f", fondu {a.fondu:.2f} s en {etapes} pas" if etapes else ", sans fondu"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
