#!/usr/bin/env python3
"""PinCabOS V3 - disentangle VPX identity, technical ROM use, and PuP-Pack.

Read-only on the NAS. Reuses VBS files extracted by the V2 mapper, then:
1. audits VBS evidence for ROM / B2S identifier / PuP-Pack;
2. identifies the represented table independently from the ROM;
3. verifies the identity against VPSDB;
4. flags borrowed ROMs, ROM-less tables, ambiguity, and real PuP-Packs.

It does not create .PinCabOs archives and never writes to the NAS.
"""
from __future__ import annotations

import csv
