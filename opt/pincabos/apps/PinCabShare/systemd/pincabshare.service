[Unit]
Description=PinCabOS PinCabShare V2 — Lobby-gated NFS CAB mesh
After=network-online.target avahi-daemon.service nfs-server.service
Wants=network-online.target avahi-daemon.service nfs-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/pincabos/apps/PinCabShare
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pincabos/apps/PinCabShare/pincabshare.py
ExecStopPost=/usr/bin/python3 /opt/pincabos/apps/PinCabShare/pincabshare.py --close
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# Le daemon doit gérer les exports NFS et les montages du namespace hôte.
# Aucun ProtectSystem/PrivateMounts ici volontairement.

[Install]
WantedBy=multi-user.target
