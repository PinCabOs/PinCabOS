#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-/target}"
PAYLOAD_DIR="${2:-/cdrom/pincabos-payload}"

echo "==============================================================="
echo " PINCABOS V8.1G — INSTALL LEAN CAB PAYLOAD"
echo "==============================================================="

[ "$(id -u)" -eq 0 ] || { echo "ERROR: root required"; exit 1; }
[ -d "$TARGET" ] || { echo "ERROR: target missing: $TARGET"; exit 1; }
findmnt "$TARGET" >/dev/null || { echo "ERROR: $TARGET not mounted"; exit 1; }

# PINCABOS_TARGET_RW_PREFLIGHT_V1
TARGET_MOUNT_OPTIONS="$(findmnt -rn -o OPTIONS --target "$TARGET" 2>/dev/null || true)"
case ",$TARGET_MOUNT_OPTIONS," in
  *,rw,*) ;;
  *)
    echo "ERROR: target is not mounted read-write: $TARGET"
    findmnt -T "$TARGET" -o SOURCE,TARGET,FSTYPE,OPTIONS 2>/dev/null || true
    exit 76
    ;;
esac

TARGET_RW_PROBE="$TARGET/.pincabos-rw-probe-$$"
if ! (
  umask 077
  printf 'PinCabOS write probe\n' > "$TARGET_RW_PROBE"
  sync "$TARGET_RW_PROBE" 2>/dev/null || sync
  rm -f "$TARGET_RW_PROBE"
); then
  rm -f "$TARGET_RW_PROBE" 2>/dev/null || true
  echo "ERROR: target write probe failed before payload extraction"
  findmnt -T "$TARGET" -o SOURCE,TARGET,FSTYPE,OPTIONS 2>/dev/null || true
  exit 77
fi

echo "GO [OK] target filesystem is mounted RW and writable"

# PINCABOS_OUTILS_CIBLE_V1 : les outils Python appliques a la cible sont des fichiers
# livres (opt/pincabos/tools/cible/). On prend ceux du payload installe (meme version que
# le systeme pose), sinon ceux du media live.
pco_outil_cible() {
  local nom="$1" d
  for d in "$TARGET/opt/pincabos/tools/cible" /opt/pincabos/tools/cible; do
    if [ -f "$d/$nom" ]; then
      printf '%s\n' "$d/$nom"
      return 0
    fi
  done
  echo "ERROR: outil cible introuvable: $nom" >&2
  return 1
}

# PINCABOS_LIVE_SQUASHFS_V1
# One payload shape (PINCABOS_ISO_MODELE_LIVE_V2): the ISO *is* the system,
# shipped as casper/filesystem.squashfs and verified by casper at boot.
LIVE_SQUASHFS="$PAYLOAD_DIR/../casper/filesystem.squashfs"

echo
echo "=== 1) Verify live squashfs ==="
[ -f "$LIVE_SQUASHFS" ] || { echo "ERROR: live squashfs missing: $LIVE_SQUASHFS"; exit 1; }
echo "Live squashfs detected, checksum already verified by casper at boot."

echo
echo "=== 2) Extract rootfs ==="
# Progress bar left on purpose: the graphical installer parses it.
unsquashfs -f -d "$TARGET" "$LIVE_SQUASHFS"
# Strip what only makes sense on live media.
rm -f "$TARGET/etc/pincabos-live" \
      "$TARGET/etc/netplan/01-pincabos-live-dhcp.yaml"
rm -f "$TARGET/etc/systemd/system/pincabos-gui-install.target" \
      "$TARGET/etc/systemd/system/pincabos-gui-install-prepare.service" \
      "$TARGET/usr/local/sbin/pincabos-gui-install-prepare"

# PINCABOS_CIBLE_FICHIERS_DU_DEPOT_V1 : scripts de premier demarrage, gardes VPinFE, unites et
# regles pinball viennent du systeme extrait (le depot est porte dans l image) ; le helper ne les
# reecrit plus. Une image qui ne les porterait pas ne doit pas s installer en silence.
for pco_attendu in \
  "etc/sudoers.d/99-pincabos-pinball-root" \
  "etc/polkit-1/rules.d/49-pincabos-pinball-root.rules" \
  "usr/local/sbin/pincabos-firstboot-network-webapp-fix" \
  "etc/systemd/system/pincabos-firstboot-network-webapp-fix.service" \
  "etc/systemd/system/pincabos-webapp.service.d/90-pincabos-stable-start.conf" \
  "usr/local/sbin/pincabos-webapp-fallback-start" \
  "etc/systemd/system/pincabos-webapp-fallback.service" \
  "usr/local/sbin/pincabos-firstboot-hardware-autoconfig" \
  "etc/systemd/system/pincabos-firstboot-hardware-autoconfig.service" \
  "etc/systemd/system/pincabos-screen-topology-boot.service" \
  "usr/local/libexec/pincabos/pincabos-vpinfe-display-sanitize" \
  "usr/local/libexec/pincabos/pincabos-vpinfe-prestart-guard" \
  "etc/systemd/system/pincabos-vpinfe.service.d/45-pincabos-vpinfe-prestart-guard.conf" \
  "etc/systemd/system/pincabos-vpinfe.service.d/90-pincabos-iso-start.conf" \
  "usr/local/sbin/pincabos-firstboot-vpinfe-packaged-runtime-fix" \
  "etc/systemd/system/pincabos-firstboot-vpinfe-packaged-runtime-fix.service" \
  "usr/local/sbin/pincabos-firstboot-initramfs-refresh" \
  "etc/systemd/system/pincabos-firstboot-initramfs-refresh.service"
do
  if [ ! -e "$TARGET/$pco_attendu" ]; then
    echo "ERROR: fichier attendu absent de la cible extraite: $pco_attendu"
    exit 78
  fi
done
echo "GO [OK] fichiers du depot presents dans la cible (18 verifies)"


echo
echo "=== PinCabOS Live pinball identity compatibility ==="
echo "PINCABOS_LIVE_PINBALL_NSS_IDENTITY_V2"

#
# The payload has now been extracted.
# Resolve the REAL target account from /target.
#
PINBALL_UID="$(
    awk -F: '$1=="pinball" {print $3; exit}' \
        "$TARGET/etc/passwd"
)"

PINBALL_GID="$(
    awk -F: '$1=="pinball" {print $4; exit}' \
        "$TARGET/etc/passwd"
)"

if [ -z "$PINBALL_UID" ] || [ -z "$PINBALL_GID" ]; then
    echo "ERROR: target user pinball does not exist after payload extraction."
    echo "Target passwd:"
    grep '^pinball:' "$TARGET/etc/passwd" 2>/dev/null || true
    exit 71
fi

case "$PINBALL_UID" in
    *[!0-9]*|'')
        echo "ERROR: invalid target pinball UID: $PINBALL_UID"
        exit 72
        ;;
esac

case "$PINBALL_GID" in
    *[!0-9]*|'')
        echo "ERROR: invalid target pinball GID: $PINBALL_GID"
        exit 73
        ;;
esac

echo "Target pinball UID:GID = $PINBALL_UID:$PINBALL_GID"

#
# The installer helper itself executes in the Ubuntu Live environment.
#
# Some existing PinCabOS installation operations still legitimately use:
#
#   install -o pinball -g pinball
#   chown pinball:pinball
#
# Those commands resolve names against the LIVE /etc/passwd, not
# /target/etc/passwd.
#
# Create a temporary NSS identity in the Live system.
# It disappears automatically when the Live ISO reboots.
#

if [ -f /etc/passwd ]; then
    sed -i '/^pinball:/d' /etc/passwd
fi

if [ -f /etc/group ]; then
    sed -i '/^pinball:/d' /etc/group
fi

printf 'pinball:x:%s:%s:PinCabOS Live Installer:/home/pinball:/bin/bash\n' \
    "$PINBALL_UID" \
    "$PINBALL_GID" \
    >> /etc/passwd

printf 'pinball:x:%s:\n' \
    "$PINBALL_GID" \
    >> /etc/group

#
# Verify NSS resolution BEFORE continuing.
#
LIVE_PINBALL_UID="$(id -u pinball 2>/dev/null || true)"
LIVE_PINBALL_GID="$(id -g pinball 2>/dev/null || true)"

if [ "$LIVE_PINBALL_UID" != "$PINBALL_UID" ] ||
   [ "$LIVE_PINBALL_GID" != "$PINBALL_GID" ]; then

    echo "ERROR: Live pinball NSS identity validation failed."
    echo "Expected : $PINBALL_UID:$PINBALL_GID"
    echo "Live     : ${LIVE_PINBALL_UID:-missing}:${LIVE_PINBALL_GID:-missing}"
    exit 74
fi

echo "GO [√] Live user pinball ready: $LIVE_PINBALL_UID:$LIVE_PINBALL_GID"

#
# Extra validation: the TARGET account must still be unchanged.
#
TARGET_CHECK_UID="$(
    awk -F: '$1=="pinball" {print $3; exit}' \
        "$TARGET/etc/passwd"
)"

TARGET_CHECK_GID="$(
    awk -F: '$1=="pinball" {print $4; exit}' \
        "$TARGET/etc/passwd"
)"

if [ "$TARGET_CHECK_UID:$TARGET_CHECK_GID" != "$PINBALL_UID:$PINBALL_GID" ]; then
    echo "ERROR: target pinball identity changed unexpectedly."
    exit 75
fi

echo "GO [√] Target pinball identity validated."


# PINCABOS_PINBALL_ROOT_ADMIN_POLICY_V1
echo
echo "=== 2c) PINCABOS POLICY: pinball UID 1000 + full local administration ==="

PCOS_TARGET_PB_UID="$(awk -F: '$1=="pinball"{print $3; exit}' "$TARGET/etc/passwd" 2>/dev/null || true)"
PCOS_TARGET_PB_GID="$(awk -F: '$1=="pinball"{print $4; exit}' "$TARGET/etc/passwd" 2>/dev/null || true)"

if [ "$PCOS_TARGET_PB_UID" != "1000" ] || [ "$PCOS_TARGET_PB_GID" != "1000" ]; then
  echo "ERROR: PinCabOS invariant failed: pinball must be uid=1000 gid=1000"
  echo "       detected uid=${PCOS_TARGET_PB_UID:-missing} gid=${PCOS_TARGET_PB_GID:-missing}"
  exit 1
fi

if [ ! -x "$TARGET/usr/bin/sudo" ]; then
  echo "ERROR: sudo missing from target rootfs"
  exit 1
fi

# Full root via sudo without password, while keeping the interactive account UID 1000.
install -d -m 0750 "$TARGET/etc/sudoers.d"
chmod 0440 "$TARGET/etc/sudoers.d/99-pincabos-pinball-root"

if [ -x "$TARGET/usr/sbin/visudo" ]; then
  chroot "$TARGET" /usr/sbin/visudo -cf /etc/sudoers.d/99-pincabos-pinball-root
fi

# Keep standard sudo group membership too.
if [ -x "$TARGET/usr/sbin/usermod" ] && grep -q '^sudo:' "$TARGET/etc/group"; then
  chroot "$TARGET" /usr/sbin/usermod -aG sudo pinball
fi

# Full local Polkit authorization for the dedicated cabinet account.
install -d -m 0755 "$TARGET/etc/polkit-1/rules.d"
chmod 0644 "$TARGET/etc/polkit-1/rules.d/49-pincabos-pinball-root.rules"

test -s "$TARGET/etc/sudoers.d/99-pincabos-pinball-root"
test -s "$TARGET/etc/polkit-1/rules.d/49-pincabos-pinball-root.rules"

# PINCABOS_ACCOUNTS_POLICY_V1
# Mot de passe par defaut du compte cabinet, et root verrouille : toute
# l'administration passe par le sudo NOPASSWD installe ci-dessus.
if [ -x "$TARGET/usr/sbin/chpasswd" ]; then
  printf 'pinball:%s\n' 'Pinball123$' | chroot "$TARGET" /usr/sbin/chpasswd
  echo "GO [OK] pinball default password set (change it after first boot)"

  printf 'root:%s\n' '!*' | chroot "$TARGET" /usr/sbin/chpasswd -e
  echo "GO [OK] root account locked (administration via sudo)"
else
  echo "WARN: chpasswd missing from target; account passwords left untouched"
fi

echo "GO [OK] target pinball uid=1000 gid=1000"
echo "GO [OK] sudo NOPASSWD: ALL installed"
echo "GO [OK] unrestricted local Polkit rule installed"

# PINCABOS_SSH_HARDENING_V1
# root est deja verrouille (root:!*), ce qui interdit le login par mot de
# passe. Mais le defaut OpenSSH d'Ubuntu (prohibit-password) laisse le login
# root PAR CLE ouvert. On le ferme pour tous les cabs, la ou l'administration
# passe de toute facon par le sudo NOPASSWD du compte pinball installe plus
# haut. Un build beta qui a besoin d'un acces root SSH pose son propre drop-in
# et deverrouille root ; l'ISO propre, elle, naît fermee.
install -d -m 0755 "$TARGET/etc/ssh/sshd_config.d"
cat > "$TARGET/etc/ssh/sshd_config.d/00-pincabos-security.conf" <<'SSHHARDEOF'
# PinCabOS - durcissement SSH par defaut.
# Interdit toute connexion SSH du compte root (mot de passe ET cle).
# L'administration locale passe par le compte pinball (sudo NOPASSWD).
PermitRootLogin no
SSHHARDEOF
chmod 0644 "$TARGET/etc/ssh/sshd_config.d/00-pincabos-security.conf"
test -s "$TARGET/etc/ssh/sshd_config.d/00-pincabos-security.conf"
echo "GO [OK] SSH root login disabled by default"


echo
echo "=== 3) Extract Plymouth overlay ==="
( cd "$PAYLOAD_DIR" && sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256 )
tar --acls --xattrs --numeric-owner -I zstd \
  -xpf "$PAYLOAD_DIR/pincabos-plymouth-theme-overlay-v8.1g.tar.zst" \
  -C "$TARGET"

echo
echo "=== 4) Validate boot/Plymouth ==="
ls "$TARGET"/boot/vmlinuz-* >/dev/null
ls "$TARGET"/boot/initrd.img-* >/dev/null
ls "$TARGET"/lib/modules/* >/dev/null
test -f "$TARGET/usr/share/plymouth/themes/pincabos/pincabos.plymouth"

echo
echo "=== 5) Chroot mounts ==="
mkdir -p "$TARGET"/dev "$TARGET"/proc "$TARGET"/sys "$TARGET"/run "$TARGET"/boot/efi
mountpoint -q "$TARGET/dev"  || mount --bind /dev  "$TARGET/dev"
mountpoint -q "$TARGET/proc" || mount --bind /proc "$TARGET/proc"
mountpoint -q "$TARGET/sys"  || mount --bind /sys  "$TARGET/sys"
mountpoint -q "$TARGET/run"  || mount --bind /run  "$TARGET/run"

echo
echo "=== 6) Restore required target dirs + force quiet splash + Plymouth ==="

# These directories must exist in the installed target.
# /var/tmp is required by update-initramfs/mktemp.
mkdir -p "$TARGET/tmp"
mkdir -p "$TARGET/var/tmp"
mkdir -p "$TARGET/var/log"
mkdir -p "$TARGET/var/cache"
mkdir -p "$TARGET/var/cache/apt/archives/partial"
mkdir -p "$TARGET/var/lib/initramfs-tools"
mkdir -p "$TARGET/etc/plymouth"

chmod 1777 "$TARGET/tmp"
chmod 1777 "$TARGET/var/tmp"

echo
echo "=== Ensure installed target has /usr/bin/python3 ==="
echo "PINCABOS_TARGET_ENSURE_PYTHON3_SYMLINK_V1"
if [ ! -e "$TARGET/usr/bin/python3" ]; then
  PYBIN="$(find "$TARGET/usr/bin" -maxdepth 1 -type f -name 'python3.*' | sort -V | tail -n 1 || true)"
  if [ -n "$PYBIN" ]; then
    ln -sfn "$(basename "$PYBIN")" "$TARGET/usr/bin/python3"
    echo "Created /usr/bin/python3 -> $(basename "$PYBIN")"
  else
    echo "WARNING: no python3 binary found in installed target"
  fi
fi

echo
echo "=== PinCabOS first boot network + WebApp self-heal ==="
# PINCABOS_ISO_AUDIO_TARGET_SANITIZER_V1
#
# Défense supplémentaire dans le système cible assemblé.

echo "PINCABOS_ISO_AUDIO_TARGET_SANITIZER_V1"

rm -f \
  "$TARGET/etc/asound.conf" \
  "$TARGET/var/lib/alsa/asound.state" \
  "$TARGET/home/pinball/.asoundrc" \
  "$TARGET/opt/pincabos/config/audio-router.json" \
  "$TARGET/opt/pincabos/config/audio.json" \
  "$TARGET/opt/pincabos/config/audio-ssf.json" \
  "$TARGET/opt/pincabos/config/ssf-commander.json"

rm -rf \
  "$TARGET/home/pinball/.config/pulse" \
  "$TARGET/home/pinball/.config/pipewire" \
  "$TARGET/home/pinball/.config/wireplumber" \
  "$TARGET/home/pinball/.local/state/pipewire" \
  "$TARGET/home/pinball/.local/state/wireplumber" \
  "$TARGET/var/lib/pipewire"

python3 "$(pco_outil_cible pincabos-cible-audio-privacy.py)" "$TARGET"

install \
  -d \
  -o pinball \
  -g pinball \
  -m 2775 \
  "$TARGET/opt/pincabos/config"

echo "GO [√] Target personal audio state removed"

echo "PINCABOS_FIRSTBOOT_NET_WEBAPP_FIX_V1"

mkdir -p "$TARGET/usr/local/sbin"
mkdir -p "$TARGET/etc/systemd/system"
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
mkdir -p "$TARGET/var/lib/pincabos"


chmod 755 "$TARGET/usr/local/sbin/pincabos-firstboot-network-webapp-fix"


ln -sfn ../pincabos-firstboot-network-webapp-fix.service \
  "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-firstboot-network-webapp-fix.service"

echo
echo "=== Force single WebApp service, mask legacy alias ==="
echo "PINCABOS_WEBAPP_SINGLE_SERVICE_FIX_V1"

mkdir -p "$TARGET/etc/systemd/system"
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
mkdir -p "$TARGET/etc/systemd/system/pincabos-webapp.service.d"

# The old pincabos-web.service is only a legacy alias and can loop with webapp.
# Mask it in the installed target so only pincabos-webapp.service is used.
rm -f "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-web.service" || true
rm -f "$TARGET/etc/systemd/system/default.target.wants/pincabos-web.service" || true
ln -sfn /dev/null "$TARGET/etc/systemd/system/pincabos-web.service"


echo
echo "=== Install WebApp fallback launcher/service ==="
echo "PINCABOS_WEBAPP_FALLBACK_SERVICE_V1"


chmod 755 "$TARGET/usr/local/sbin/pincabos-webapp-fallback-start"


echo
echo "=== Pre-enable WebApp service in installed target when present ==="
if [ -f "$TARGET/etc/systemd/system/pincabos-webapp.service" ]; then
  ln -sfn ../pincabos-webapp.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-webapp.service" || true
elif [ -f "$TARGET/lib/systemd/system/pincabos-webapp.service" ]; then
  ln -sfn /lib/systemd/system/pincabos-webapp.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-webapp.service" || true
elif [ -f "$TARGET/usr/lib/systemd/system/pincabos-webapp.service" ]; then
  ln -sfn /usr/lib/systemd/system/pincabos-webapp.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-webapp.service" || true
else
  echo "NOTICE: pincabos-webapp.service not found in target at install time."
fi

echo


echo
echo "==============================================================="
echo " PinCabOS installed target automatic GPU/display pipeline"
echo " PINCABOS_TARGET_AUTO_GPU_DISPLAY_VPINFE_PIPELINE_V1"
echo "==============================================================="

mkdir -p "$TARGET/usr/local/sbin"
mkdir -p "$TARGET/etc/systemd/system"
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
mkdir -p "$TARGET/var/lib/pincabos"
mkdir -p "$TARGET/opt/pincabos/config/screens"
mkdir -p "$TARGET/opt/pincabos/state"

echo
echo "=== Remove source-cabinet GPU and display identity ==="

rm -f \
  "$TARGET/opt/pincabos/config/screens/screens.json" \
  "$TARGET/opt/pincabos/config/screens/screens-detected.json" \
  "$TARGET/opt/pincabos/config/screens/screens.env" \
  "$TARGET/opt/pincabos/config/screens/layout.conf" \
  "$TARGET/opt/pincabos/config/screens/display-role-bindings.json" \
  "$TARGET/opt/pincabos/config/display-aliases.env" \
  "$TARGET/opt/pincabos/state/screens-apply-last-success.flag" \
  "$TARGET/opt/pincabos/state/gpu-update-last-success.flag" \
  "$TARGET/opt/pincabos/state/gpu-update-required-reboot.flag" \
  "$TARGET/var/lib/pincabos/hardware-autoconfig.done" \
  "$TARGET/var/lib/pincabos/hardware-autoconfig.reboot-pending" \
  "$TARGET/var/lib/pincabos/hardware-autoconfig.failed"

echo
echo "=== Remove source X11 and XRandR identity ==="
echo "PINCABOS_TARGET_SOURCE_HARDWARE_IDENTITY_PURGE_V2"

# PINCABOS_TARGET_LIVE_INSTALLER_RESIDUE_PURGE_V1
echo "Purge live-installer residue from installed target"

rm -f \
  "$TARGET/etc/systemd/system/pincabos-live-installer-tty.service" \
  "$TARGET/etc/systemd/system/multi-user.target.wants/pincabos-live-installer-tty.service" \
  "$TARGET/etc/systemd/system/graphical.target.wants/pincabos-live-installer-tty.service" \
  "$TARGET/usr/local/sbin/pincabos-live-installer" \
  "$TARGET/etc/skel/Desktop/Install-PinCabOS.desktop" \
  2>/dev/null || true


# A generated xorg.conf must never be transferred to another machine.
rm -f \
  "$TARGET/etc/X11/xorg.conf" \
  "$TARGET/etc/X11/xorg.conf.backup" \
  "$TARGET/etc/X11/xorg.conf.nvidia-xconfig-original" \
  "$TARGET/etc/X11/xorg.conf.failsafe" 2>/dev/null || true

find "$TARGET/etc/X11" -maxdepth 1 \
  \( -type f -o -type l \) \
  -name 'xorg.conf.*' -delete 2>/dev/null || true

# Keep generic input configuration, but remove local GPU/monitor layouts.
if [ -d "$TARGET/etc/X11/xorg.conf.d" ]; then
  while IFS= read -r -d '' conf; do
    if grep -Eqi \
      'Section[[:space:]]+"(Device|Monitor|Screen|ServerLayout)"|Driver[[:space:]]+"(nvidia|nouveau|amdgpu|radeon|intel|modesetting)"|HDMI-[0-9]|DP-[0-9]|DVI-[A-Za-z0-9-]*|Virtual-[0-9]' \
      "$conf"; then
      echo "Removing source Xorg fragment: ${conf#$TARGET}"
      rm -f "$conf"
    fi
  done < <(
    find "$TARGET/etc/X11/xorg.conf.d" -maxdepth 1 \
      -type f -name '*.conf' -print0 2>/dev/null
  )
fi

# Remove desktop-specific monitor databases and static XRandR startup files.
for profile in \
  "$TARGET/home/pinball" \
  "$TARGET/root"
do
  [ -d "$profile" ] || continue

  rm -f \
    "$profile/.config/monitors.xml" \
    "$profile/.config/monitors.xml~" 2>/dev/null || true

  rm -rf "$profile/.screenlayout" 2>/dev/null || true

  for startup_file in \
    "$profile/.xprofile" \
    "$profile/.xsessionrc" \
    "$profile/.xinitrc" \
    "$profile/.config/openbox/autostart" \
    "$profile/.config/lxsession/LXDE/autostart" \
    "$profile/.config/lxsession/LXDE-pi/autostart"
  do
    [ -f "$startup_file" ] || continue

    if grep -Eqi \
      '(^|[[:space:]])xrandr([[:space:]]|$)|HDMI-[0-9]|DP-[0-9]|DVI-[A-Za-z0-9-]*|Virtual-[0-9]' \
      "$startup_file"; then
      echo "Removing source display startup file: ${startup_file#$TARGET}"
      rm -f "$startup_file"
    fi
  done

  if [ -d "$profile/.config/autostart" ]; then
    while IFS= read -r -d '' autostart_file; do
      if grep -Eqi \
        '(^|[[:space:]])xrandr([[:space:]]|$)|HDMI-[0-9]|DP-[0-9]|DVI-[A-Za-z0-9-]*|Virtual-[0-9]' \
        "$autostart_file"; then
        echo "Removing source display autostart: ${autostart_file#$TARGET}"
        rm -f "$autostart_file"
      fi
    done < <(
      find "$profile/.config/autostart" -maxdepth 1 \
        -type f -print0 2>/dev/null
    )
  fi
done

# Remove system-level scripts that impose a source-machine XRandR layout.
for startup_dir in \
  "$TARGET/etc/lightdm/lightdm.conf.d" \
  "$TARGET/etc/X11/Xsession.d" \
  "$TARGET/etc/xdg/autostart"
do
  [ -d "$startup_dir" ] || continue

  while IFS= read -r -d '' startup_file; do
    if grep -Eqi \
      '(^|[[:space:]])xrandr([[:space:]]|$)|display-setup-script=.*xrandr|session-setup-script=.*xrandr|HDMI-[0-9]|DP-[0-9]|DVI-[A-Za-z0-9-]*|Virtual-[0-9]' \
      "$startup_file"; then
      echo "Removing source system display startup: ${startup_file#$TARGET}"
      rm -f "$startup_file"
    fi
  done < <(
