  esac
done

echo
pco_step "Final validation"
find "$TARGET/boot" -maxdepth 2 -type f | sort | sed -n '1,120p'
ls -lah "$TARGET/lib/modules"
cat "$TARGET/etc/fstab"
grep -R "quiet splash\|PinCabOS\|pincabos\|plymouth" \
  "$TARGET/etc/default/grub" \
  "$TARGET/etc/plymouth/plymouthd.conf" \
  "$TARGET/boot/grub/grub.cfg" \
  2>/dev/null || true

test -s "$TARGET/etc/fstab"
test -d "$TARGET/boot/efi"
ls "$TARGET"/boot/vmlinuz-* >/dev/null
ls "$TARGET"/boot/initrd.img-* >/dev/null
test -d "$TARGET/opt/pincabos"

pco_go "Validation finale du système installé réussie"

echo
pco_hr
pco_go "$(t done_ok)"
pco_warn "$(t done_remove)"
pco_hr
if [ -n "${PCO_ANSWERS:-}" ]; then
  pco_go "PINCABOS_INSTALL_COMPLETE"
  exit 0
fi
pco_prompt "$(t done_reboot)"
read -r
reboot
