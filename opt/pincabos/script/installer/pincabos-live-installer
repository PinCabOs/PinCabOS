  "etc/netplan"
  "etc/ssh"
  "etc/machine-id"
  "var/lib/NetworkManager"
)

PCO_KEEP_DIR="/run/pincabos-keep"

save_user_settings() {
  rm -rf "$PCO_KEEP_DIR"
  mkdir -p "$PCO_KEEP_DIR"

  # PINCABOS_KEEP_SPACE_CHECK_V1
  # /run est en memoire vive, et deux entrees de la liste n'ont pas de borne
  # connue : les medias et la base VPSdb. On mesure avant de copier, et on
  # refuse en annoncant le chiffre plutot que d'echouer au milieu sur un cp.
  local besoin=0 dispo=0 p taille
  for p in "${PCO_KEEP_PATHS[@]}"; do
    [ -e "$TARGET/$p" ] || continue
    taille="$(du -sk --apparent-size "$TARGET/$p" 2>/dev/null | cut -f1)"
    besoin=$((besoin + ${taille:-0}))
  done
  dispo="$(df -Pk "$PCO_KEEP_DIR" | awk 'NR==2 {print $4}')"
  # Marge : /run sert aussi au reste du systeme pendant l'installation.
  if [ "$besoin" -gt 0 ] && [ $((besoin + 65536)) -gt "${dispo:-0}" ]; then
    pco_error "Not enough room in $PCO_KEEP_DIR to set your settings aside: $((besoin / 1024)) MB needed, $((${dispo:-0} / 1024)) MB free. Nothing has been touched."
    return 1
  fi

  local kept=0 p
  for p in "${PCO_KEEP_PATHS[@]}"; do
    [ -e "$TARGET/$p" ] || continue
    mkdir -p "$PCO_KEEP_DIR/$(dirname "$p")"
    cp -a "$TARGET/$p" "$PCO_KEEP_DIR/$p"
    kept=$((kept + 1))
  done
  pco_go "$(t up_saved) ($kept)"
}

restore_user_settings() {
  local restored=0 p
  for p in "${PCO_KEEP_PATHS[@]}"; do
    [ -e "$PCO_KEEP_DIR/$p" ] || continue
    mkdir -p "$TARGET/$(dirname "$p")"
    if [ -d "$PCO_KEEP_DIR/$p" ] && [ ! -L "$PCO_KEEP_DIR/$p" ]; then
      # PINCABOS_KEEP_MERGE_V1 : un dossier est fusionne. Les fichiers du cab
      # remplacent ceux de l'image, mais ce que l'installateur vient d'ecrire
      # dans la cible reste (drapeaux dmd/reseau/son, profils netplan de la
      # session) : rm -rf les effacait a chaque mise a jour.
      mkdir -p "$TARGET/$p"
      cp -a "$PCO_KEEP_DIR/$p/." "$TARGET/$p/"
    else
      rm -rf "$TARGET/$p"
      cp -a "$PCO_KEEP_DIR/$p" "$TARGET/$p"
    fi
    restored=$((restored + 1))
  done
  # Owners are not carried by the archive: give the pinball files back.
  if [ -d "$TARGET/home/pinball" ]; then
    chroot "$TARGET" chown -R pinball:pinball /home/pinball/.config 2>/dev/null || true
  fi
  rm -rf "$PCO_KEEP_DIR"
  pco_go "$(t up_restored) ($restored)"
}

upgrade_install() {
  choose_disk "$(t disks_upgrade)"
  part_paths_for_disk "$DISK"

  echo
  pco_step "$(t up_scan)"
  [ -b "$ROOT_PART" ] || { pco_error "$(t up_none)"; return 1; }

  unmount_disk_mounts "$DISK"
  prepare_target_mount
  mount -o rw "$ROOT_PART" "$TARGET" || { pco_error "$(t up_none)"; return 1; }
  verify_target_rw || {
    show_target_storage_diagnostics
    umount -R "$TARGET" 2>/dev/null || true
    return 1
  }

  # An update must not be able to wipe a stranger's disk: refuse anything that
  # is not recognisably a PinCabOS root.
  if [ ! -d "$TARGET/opt/pincabos" ] || [ ! -d "$TARGET/home/pinball" ]; then
    umount -R "$TARGET" 2>/dev/null || true
    pco_error "$(t up_none)"
    return 1
  fi
  pco_go "$(t up_found)"

  mkdir -p "$TARGET/boot/efi"
  if [ -b "$EFI_PART" ]; then
    mount "$EFI_PART" "$TARGET/boot/efi" || true
  fi
  mountpoint -q "$TARGET/boot/efi" || {
    umount -R "$TARGET" 2>/dev/null || true
    pco_error "EFI partition not mounted, aborting update"
    return 1
  }

  save_user_settings
  # unsquashfs -f overwrites in place: system files are refreshed, everything
  # outside the image (tables, media next to them) is left alone.
  install_payload "upgrade"
  restore_user_settings
  # PINCABOS_INSTALLEUR_RESEAU_V2 : la restauration ramene les profils netplan et
  # les drapeaux du cab ; le choix reseau fait dans l'installateur est rejoue.
  apply_target_network
  write_fstab "$ROOT_PART" "$EFI_PART"
  final_boot_refresh "upgrade"
}

find_efi_partition() {
  local disk="$1"

  lsblk -rpno NAME,FSTYPE,PARTTYPE "$disk" \
    | awk 'tolower($3)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}'

  return 0
}

list_free_spaces() {
  local disk="$1"

  parted -m "$disk" unit MiB print free \
    | awk -F: -v min="$MIN_FREE_MIB" '
      /free/ {
        start=$2
        end=$3
        size=$4
        gsub(/MiB/,"",start)
        gsub(/MiB/,"",end)
        gsub(/MiB/,"",size)
        if ((size+0) >= min) {
          printf "%.2f|%.2f|%.2f\n", start, end, size
        }
      }
    '
}

dualboot_install() {
  choose_disk "$(t disks_dual)"

  echo
  echo "$(t disk_selected)"
  lsblk -dpno NAME,SIZE,MODEL "$DISK"
  echo
  echo "Dualboot mode will NOT resize partitions."
  echo "It only uses existing unallocated/free space on the selected disk."
  echo

  EFI_PART="$(find_efi_partition "$DISK" || true)"

  if [ -z "$EFI_PART" ]; then
    pco_error "no existing EFI System Partition found on $DISK."
    echo "Dualboot mode requires an existing EFI partition on the same disk."
    exit 1
  fi

  echo "Existing EFI partition found:"
  lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$EFI_PART" || true

  mapfile -t FREE_SPACES < <(list_free_spaces "$DISK")

  if [ "${#FREE_SPACES[@]}" -eq 0 ]; then
    echo
    pco_error "no unallocated space >= ${MIN_FREE_MIB}MiB found on $DISK."
    echo "Create unallocated space first, then rerun this installer."
    echo "No existing partition was modified."
    exit 1
  fi

  echo
  echo "Available unallocated spaces:"
  local i=1 row start end size gib
  for row in "${FREE_SPACES[@]}"; do
    IFS='|' read -r start end size <<<"$row"
    gib="$(awk -v m="$size" 'BEGIN { printf "%.1f", m/1024 }')"
    echo "  [$i] start=${start}MiB end=${end}MiB size=${gib}GiB"
    i=$((i+1))
  done

  echo
  pco_prompt "Select free space number: "
  read -r FREE_CHOICE

  [[ "$FREE_CHOICE" =~ ^[0-9]+$ ]] || {
    echo "$(t invalid)"
    exit 1
  }

  FREE_IDX=$((FREE_CHOICE-1))
  if [ "$FREE_IDX" -lt 0 ] || [ "$FREE_IDX" -ge "${#FREE_SPACES[@]}" ]; then
    echo "$(t out_of_range)"
    exit 1
  fi

  IFS='|' read -r START_MIB END_MIB SIZE_MIB <<<"${FREE_SPACES[$FREE_IDX]}"
  END_SAFE_MIB="$(awk -v e="$END_MIB" 'BEGIN { printf "%.2f", e-1 }')"

  echo
  pco_warn ""
  echo "This will create a new PinCabOS ext4 partition only in this free space:"
  echo "  Disk:  $DISK"
  echo "  Start: ${START_MIB}MiB"
  echo "  End:   ${END_SAFE_MIB}MiB"
  echo "  EFI:   $EFI_PART will be reused, NOT formatted"
  echo
  pco_prompt "Type INSTALL PINCABOS DUALBOOT to continue: "
  if [ -n "${PCO_ANS_DISK:-}" ]; then CONFIRM="INSTALL PINCABOS DUALBOOT"; echo "$CONFIRM"; else read -r CONFIRM; fi

  [ "$CONFIRM" = "INSTALL PINCABOS DUALBOOT" ] || {
    echo "$(t cancelled)"
    exit 1
  }

  echo
  pco_step "Creating PinCabOS root partition in free space"
  parted -s "$DISK" unit MiB mkpart PINCABOS_ROOT ext4 "${START_MIB}MiB" "${END_SAFE_MIB}MiB"
  partprobe "$DISK"
  udevadm settle
  sleep 2

  ROOT_PART="$(lsblk -rpno NAME,PARTLABEL "$DISK" | awk '$2=="PINCABOS_ROOT"{print $1}' | tail -n1)"

  if [ -z "$ROOT_PART" ] || [ ! -b "$ROOT_PART" ]; then
    pco_error "could not locate new PINCABOS_ROOT partition."
    lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$DISK"
    exit 1
  fi

  pco_go "Partition PinCabOS créée dans l’espace libre"

  echo
  echo "New PinCabOS root partition:"
  lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$ROOT_PART" || true

  echo
  pco_step "Formatting PinCabOS root only"
  mkfs.ext4 -F -L rootfs "$ROOT_PART"

  [ "$(blkid -s TYPE -o value "$ROOT_PART")" = "ext4" ]

  pco_go "Partition PinCabOS formatée en ext4"

  echo
  pco_step "Mounting target"
  prepare_target_mount
  mount -o rw "$ROOT_PART" "$TARGET"
  verify_target_rw
  mkdir -p "$TARGET/boot/efi"
  mount "$EFI_PART" "$TARGET/boot/efi"

  mountpoint -q "$TARGET"
  mountpoint -q "$TARGET/boot/efi"

  pco_go "Partitions root et EFI montées (root RW vérifiée)"

  install_payload "dualboot"
  write_fstab "$ROOT_PART" "$EFI_PART"
  final_boot_refresh "dualboot"
}

check_payload

regional_setup

while true; do
  echo
  pco_hr
  echo " $(t mode_title)"
  pco_hr
  echo
  echo "  [1] $(t mode_1)"
  echo "      $(t mode_1b)"
  echo
  echo "  [2] $(t mode_2)"
  echo "      $(t mode_2b)"
  echo
  echo "  [3] $(t mode_up)"
  echo "      $(t mode_upb)"
  echo
  echo "  [4] $(t mode_3)"
  echo
  echo "  [5] $(t mode_4)"
  echo
  pco_prompt "$(t choice): "
  if [ -n "${PCO_ANS_MODE:-}" ]; then MODE="$PCO_ANS_MODE"; echo "$MODE"; else read -r MODE; fi

  case "$MODE" in
    1) full_disk_install; break ;;
    2) dualboot_install; break ;;
    3) upgrade_install && break ;;
    4) bash ;;
