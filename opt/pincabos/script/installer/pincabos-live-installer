pco_choose_list() {
    local title="$1"
    local source_file="$2"

    local PAGE_SIZE=20
    local PAGE=0
    local FILTER="${3:-}"
    local CHOICE=""
    local SEARCH=""
    local TMP_FILTER=""

    while true; do
        TMP_FILTER="$(mktemp)"

        if [ -n "$FILTER" ]; then
            grep -iF -- "$FILTER" "$source_file" \
                > "$TMP_FILTER" || true
        else
            cat "$source_file" > "$TMP_FILTER"
        fi

        mapfile -t PCO_ITEMS < "$TMP_FILTER"
        rm -f "$TMP_FILTER"

        local TOTAL="${#PCO_ITEMS[@]}"

        if [ "$TOTAL" -eq 0 ]; then
            echo
            pco_warn "No entry matches: $FILTER"
            FILTER=""
            PAGE=0
            continue
        fi

        local PAGES=$(( (TOTAL + PAGE_SIZE - 1) / PAGE_SIZE ))

        [ "$PAGE" -lt "$PAGES" ] || PAGE=$((PAGES - 1))
        [ "$PAGE" -ge 0 ] || PAGE=0

        local START=$((PAGE * PAGE_SIZE))
        local END=$((START + PAGE_SIZE))

        [ "$END" -le "$TOTAL" ] || END="$TOTAL"

        echo
        pco_hr
        echo " $title"
        pco_hr
        echo
        echo " $(t entries) : $TOTAL"
        echo " $(t page)    : $((PAGE + 1)) / $PAGES"

        if [ -n "$FILTER" ]; then
            echo " $(t filter)  : $FILTER"
        fi

        echo

        local IDX
        local NUM=1

        for ((IDX=START; IDX<END; IDX++)); do
            local LINE="${PCO_ITEMS[$IDX]}"
            local VALUE="${LINE%%|*}"
            local LABEL="${LINE#*|}"

            printf "  [%2d] %-22s %s\n" \
                "$NUM" \
                "$VALUE" \
                "$LABEL"

            NUM=$((NUM + 1))
        done

        echo
        echo "  $(t next_page)"
        echo "  $(t prev_page)"
        echo "  $(t search_filter)"
        echo "  $(t clear_search)"
        echo

        pco_prompt "$(t choice): "
        read -r CHOICE

        case "$CHOICE" in
            n|N)
                if [ "$((PAGE + 1))" -lt "$PAGES" ]; then
                    PAGE=$((PAGE + 1))
                fi
                ;;

            p|P)
                if [ "$PAGE" -gt 0 ]; then
                    PAGE=$((PAGE - 1))
                fi
                ;;

            s|S)
                echo
                pco_prompt "$(t search): "
                read -r SEARCH
                FILTER="$SEARCH"
                PAGE=0
                ;;

            c|C)
                FILTER=""
                PAGE=0
                ;;

            *)
                if [[ "$CHOICE" =~ ^[0-9]+$ ]]; then
                    local LOCAL_INDEX=$((CHOICE - 1))

                    if [ "$LOCAL_INDEX" -ge 0 ] &&
                       [ "$LOCAL_INDEX" -lt "$((END - START))" ]; then

                        local ABS_INDEX=$((START + LOCAL_INDEX))
                        local SELECTED="${PCO_ITEMS[$ABS_INDEX]}"

                        PCO_SELECTED="${SELECTED%%|*}"
                        PCO_SELECTED_LABEL="${SELECTED#*|}"

                        return 0
                    fi
                fi

                pco_warn "Invalid choice."
                ;;
        esac
    done
}

pco_build_locale_catalog() {
    local OUT="$1"

    : > "$OUT"

    if [ -f /usr/share/i18n/SUPPORTED ]; then
        awk '
            $2 == "UTF-8" {
                print $1 "|" $1
            }
        ' /usr/share/i18n/SUPPORTED \
            | sort -u \
            > "$OUT"
    fi

    if [ ! -s "$OUT" ]; then
        locale -a 2>/dev/null \
            | grep -Ei 'utf[-]?8' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    #
    # Garantir les principales locales même si l'image Live
    # expose une liste incomplète.
    #
    for LOC in \
        fr_CA.UTF-8 \
        en_CA.UTF-8 \
        en_US.UTF-8 \
        fr_FR.UTF-8
    do
        grep -q "^${LOC}|" "$OUT" 2>/dev/null ||
            printf '%s|%s\n' "$LOC" "$LOC" >> "$OUT"
    done

    sort -u -o "$OUT" "$OUT"
}

pco_build_keyboard_catalog() {
    local OUT="$1"

    : > "$OUT"

    local RULES=""

    for CANDIDATE in \
        /usr/share/X11/xkb/rules/base.lst \
        /usr/share/X11/xkb/rules/evdev.lst
    do
        if [ -f "$CANDIDATE" ]; then
            RULES="$CANDIDATE"
            break
        fi
    done

    if [ -n "$RULES" ]; then
        awk '
            /^! layout/ {
                active=1
                next
            }

            /^!/ {
                if (active) exit
            }

            active && NF {
                code=$1
                $1=""
                sub(/^[[:space:]]+/, "", $0)
                print code "|" $0
            }
        ' "$RULES" \
            | sort -u \
            > "$OUT"
    fi

    if [ ! -s "$OUT" ] &&
       command -v localectl >/dev/null 2>&1; then

        localectl list-x11-keymap-layouts \
            --no-pager 2>/dev/null \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    [ -s "$OUT" ] || {
        printf '%s\n' \
            'us|English (US)' \
            'ca|Canada' \
            'fr|France' \
            'gb|United Kingdom' \
            > "$OUT"
    }
}

pco_build_keyboard_variant_catalog() {
    local LAYOUT="$1"
    local OUT="$2"

    : > "$OUT"

    #
    # Option par défaut toujours disponible.
    #
    echo '|Default / no variant' > "$OUT"

    if command -v localectl >/dev/null 2>&1; then
        localectl list-x11-keymap-variants \
            "$LAYOUT" \
            --no-pager 2>/dev/null \
            | grep -v '^$' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            >> "$OUT" || true
    fi

    #
    # Fallback base.lst / evdev.lst.
    #
    if [ "$(wc -l < "$OUT")" -le 1 ]; then
        local RULES=""

        for CANDIDATE in \
            /usr/share/X11/xkb/rules/base.lst \
            /usr/share/X11/xkb/rules/evdev.lst
        do
            if [ -f "$CANDIDATE" ]; then
                RULES="$CANDIDATE"
                break
            fi
        done

        if [ -n "$RULES" ]; then
            awk -v wanted="$LAYOUT" '
                /^! variant/ {
                    active=1
                    next
                }

                /^!/ {
                    if (active) exit
                }

                active && NF {
                    variant=$1

                    line=$0

                    if (
                        line ~ ("[[:space:]]" wanted ":") ||
                        line ~ ("^" variant "[[:space:]]+" wanted ":")
                    ) {
                        desc=line
                        sub(/^[^[:space:]]+[[:space:]]+/, "", desc)
                        print variant "|" desc
                    }
                }
            ' "$RULES" \
                | sort -u \
                >> "$OUT" || true
        fi
    fi

    sort -u -o "$OUT" "$OUT"
}

pco_build_timezone_catalog() {
    local OUT="$1"

    : > "$OUT"

    if command -v timedatectl >/dev/null 2>&1; then
        timedatectl list-timezones \
            --no-pager 2>/dev/null \
            | grep '/' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    if [ ! -s "$OUT" ] &&
       [ -f /usr/share/zoneinfo/zone.tab ]; then

        awk '
            !/^#/ && NF >= 3 {
                print $3 "|" $3
            }
        ' /usr/share/zoneinfo/zone.tab \
            | sort -u \
            > "$OUT"
    fi

    grep -q '^UTC|' "$OUT" 2>/dev/null ||
        echo 'UTC|UTC' >> "$OUT"

    sort -u -o "$OUT" "$OUT"
}

apply_live_keyboard() {
    echo
    pco_step "Applying keyboard to live installer"

    mkdir -p /etc/default

    cat > /etc/default/keyboard <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$REG_XKB_LAYOUT"
XKBVARIANT="$REG_XKB_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF

    if command -v setupcon >/dev/null 2>&1; then
        if setupcon --keyboard-only >/dev/null 2>&1; then
            pco_go "Live keyboard applied: $REG_KEYBOARD_LABEL"
            return 0
        fi
    fi

    if command -v ckbcomp >/dev/null 2>&1 &&
       command -v loadkeys >/dev/null 2>&1; then

        if [ -n "$REG_XKB_VARIANT" ]; then
            if ckbcomp \
                "$REG_XKB_LAYOUT" \
                "$REG_XKB_VARIANT" \
                2>/dev/null \
                | loadkeys >/dev/null 2>&1; then

                pco_go "Live keyboard applied"
                return 0
            fi
        else
            if ckbcomp \
                "$REG_XKB_LAYOUT" \
                2>/dev/null \
                | loadkeys >/dev/null 2>&1; then

                pco_go "Live keyboard applied"
                return 0
            fi
        fi
    fi

    pco_warn "Live keyboard could not be changed."
    echo "The selected keyboard will still be installed on the target."
}

