      <layer>above</layer>
      <skip_pager>yes</skip_pager>
      <skip_taskbar>yes</skip_taskbar>
      <position force="yes"><x>24</x><y>24</y><monitor>6</monitor></position>
    </application>
    <application title="pincabos-identify-7">
