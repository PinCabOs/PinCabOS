#!/usr/bin/env python3
"""PinCabOS — DMD LED reel : ZeDMD (USB ou Wi-Fi) et PIN2DMD, pour VPX et VPinFE.

PINCABOS_ZEDMD_V2 (le nom de l'outil est historique ; il couvre aussi le PIN2DMD)

Source de verite : /opt/pincabos/config/zedmd.json
    {"mode": "off|usb|wifi|pin2dmd", "device": "", "wifi_addr": "", "brightness": -1,
     "targets": "game|both"}

PIN2DMD : USB brut via libusb (0314:e457, produit PIN2DMD / XL / HD), pris en
charge par le plugin DMDUtil de VPX (en jeu). La lib libdmdutil embarquee dans
VPinFE (0.11, liee en dur au bridge) n'a pas le code PIN2DMD : pas de menu.
L'acces USB en tant que pinball exige la regle udev livree
(etc/udev/rules.d/99-pincabos-pin2dmd.rules).

Ce script est l'UNIQUE ecrivain des sections [Plugin.DMDUtil] de VPinballX.ini
et [libdmdutil] de vpinfe.ini : la page web ne fait que modifier le JSON puis
appeler `apply`.

  detect            Ports serie USB presents, classes (candidat ZeDMD / occupe / inconnu)
  status            Etat JSON (config + ce que lisent VPX et VPinFE)
  set '<json>'      Enregistre la configuration (appele via sudo par la page web)
  apply             Config -> les deux INI (imprime RESTART_VPINFE=1 si vpinfe.ini a change)
  test [secondes]   Affiche une mire sur le ZeDMD via le bridge libdmdutil de VPinFE
  image <fichier> [secondes]   Affiche une image ajustee a la matrice (ZeDMD)

Regles :
  - VPX et VPinFE/libdmdutil savent chercher le ZeDMD USB : device vide = auto.
  - Un port USB ne se partage pas simultanement : VPinFE libere libdmdutil avant
    VPX et le reprend au retour au menu. USB peut donc servir au menu + au jeu.
  - Par defaut : ZeDMD USB/Wi-Fi -> menu + jeu ; PIN2DMD -> jeu seulement.
  - Un chemin /dev/serial/by-id/... peut etre force en override si necessaire.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
# PINCABOS_PATHS_CONSUMER_V1
# pincabos_paths vit dans /opt/pincabos/tools ; hors cabinet (tests, CI), on
# le trouve a cote, dans le depot.
import os as _pco_os
import sys as _pco_sys
for _pco_dir in ("/opt/pincabos/tools",
                 _pco_os.path.join(_pco_os.path.dirname(_pco_os.path.abspath(__file__)), "..", "tools")):
    if _pco_dir not in _pco_sys.path:
        _pco_sys.path.insert(0, _pco_dir)
from pincabos_paths import PATHS

CONFIG = "/opt/pincabos/config/zedmd.json"
VPX_INI_CANDIDATES = (
    PATHS.vpx_ini,
    PATHS.vpx_legacy_pref + "/VPinballX.ini",
)
VPINFE_INI = PATHS.vpinfe_ini
CABINET_XML = PATHS.cabinet_xml
VPINFE_DMDUTIL_DIR = PATHS.vpinfe_dmdutil
PIN2DMD_VID, PIN2DMD_PID = "0314", "e457"   # src/PIN2DMD.cpp de libdmdutil
PIN2DMD_UDEV_RULE = "/etc/udev/rules.d/99-pincabos-pin2dmd.rules"
MODES = ("off", "usb", "wifi", "pin2dmd")

DEFAULTS = {"mode": "off", "device": "", "wifi_addr": "", "brightness": -1, "targets": ""}

# VID USB -> famille. Le ZeDMD est un ESP32 : soit port natif Espressif, soit
# pont serie CP210x / CH340 (VID partages avec d'autres cartes, donc "possible").
VID_FAMILY = {
    "303a": ("esp32", "ESP32 natif (Espressif) — ZeDMD probable"),
    "10c4": ("bridge", "pont serie CP210x — ZeDMD possible (ou autre carte ESP)"),
    "1a86": ("bridge", "pont serie CH340 — ZeDMD possible (ou autre carte ESP)"),
    "16c0": ("teensy", "Teensy — controleur LED / DOF, pas un ZeDMD"),
    "2e8a": ("pico", "Raspberry Pico / DudesCab — pas un ZeDMD"),
    "0314": ("pin2dmd", "PIN2DMD — pas un ZeDMD"),
}


def load_config():
    data = dict(DEFAULTS)
    try:
        with open(CONFIG, encoding="utf-8") as f:
            loaded = json.load(f) or {}
        if isinstance(loaded, dict):
            data.update({k: loaded.get(k, v) for k, v in DEFAULTS.items()})
    except (OSError, ValueError):
        pass
    if data["mode"] not in MODES:
        data["mode"] = "off"
    if data["targets"] not in ("game", "both"):
        data["targets"] = "game" if data["mode"] == "pin2dmd" else "both"
    try:
        data["brightness"] = int(data["brightness"])
    except (TypeError, ValueError):
        data["brightness"] = -1
    if not 0 <= data["brightness"] <= 15:
        data["brightness"] = -1
    data["device"] = str(data["device"] or "").strip()
    data["wifi_addr"] = str(data["wifi_addr"] or "").strip()
    return data


def save_config(data):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    tmp = CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, CONFIG)
    _chown_pinball(CONFIG)


def _chown_pinball(path):
    if os.geteuid() == 0:
        try:
            shutil.chown(path, "pinball", "pinball")
        except (OSError, LookupError):
            pass


def ensure_pinball_serial_access():
    """Best-effort: garantit l'acces aux tty USB sur Debian/Ubuntu.

    La commande `apply` est normalement lancee via sudo par PinCabOS. Ajouter
    pinball a dialout est idempotent. L'echec reste un avertissement afin qu'un
    DMD debranche ne bloque jamais une mise a jour du cabinet.
    """
    if os.geteuid() != 0 or not shutil.which("usermod"):
        return
    try:
        p = subprocess.run(["id", "-nG", "pinball"], capture_output=True, text=True, timeout=5)
        if p.returncode == 0 and "dialout" in p.stdout.split():
            return
        p = subprocess.run(["usermod", "-aG", "dialout", "pinball"], capture_output=True, text=True, timeout=10)
        if p.returncode == 0:
            print("USB      : utilisateur pinball ajoute au groupe dialout")
        else:
            print("AVERTISSEMENT: impossible d'ajouter pinball a dialout : " + (p.stderr.strip() or str(p.returncode)))
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"AVERTISSEMENT: verification dialout impossible ({exc})")


# --- INI ---------------------------------------------------------------------
_SECTION_RE = re.compile(r"^\s*\[(.+?)\]\s*$")


def read_section(text, section):
    """Cles (minuscules) -> valeurs de la section demandee."""
    values = {}
    inside = False
    for line in text.split("\n"):
        m = _SECTION_RE.match(line)
        if m:
            inside = m.group(1).strip().lower() == section.lower()
            continue
        if not inside or not line.strip() or line.lstrip().startswith((";", "#")):
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            values[k.strip().lower()] = v.strip()
    return values


def update_section(text, section, values):
    """Met a jour les cles d'une section en conservant le format du fichier ;
    cles absentes ajoutees en fin de section, section absente creee."""
    lines = text.split("\n")
    start = None
    end = len(lines)
    for i, line in enumerate(lines):
        m = _SECTION_RE.match(line)
        if not m:
            continue
        if start is not None:
            end = i
            break
        if m.group(1).strip().lower() == section.lower():
            start = i
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(f"[{section}]")
        for k, v in values.items():
            lines.append(f"{k} = {v}")
        lines.append("")
        return "\n".join(lines)
    remaining = dict(values)
    for i in range(start + 1, end):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith((";", "#")) or "=" not in line:
            continue
        key = line.split("=", 1)[0].strip()
        for want in list(remaining):
            if key.lower() == want.lower():
                lines[i] = f"{key} = {remaining.pop(want)}"
    insert_at = end
    while insert_at > start + 1 and not lines[insert_at - 1].strip():
        insert_at -= 1
    for k, v in remaining.items():
        lines.insert(insert_at, f"{k} = {v}")
        insert_at += 1
    return "\n".join(lines)


def write_atomic(path, text):
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".zedmd-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        try:
            st = os.stat(path)
            os.chmod(tmp, st.st_mode & 0o7777)
            if os.geteuid() == 0:
                os.chown(tmp, st.st_uid, st.st_gid)
        except OSError:
            pass
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def vpx_ini_path():
    for p in VPX_INI_CANDIDATES:
        if os.path.isfile(p):
            return p
    return None


def _truthy(v):
    return str(v or "").strip().lower() in ("1", "true", "yes", "on")


# --- detection ---------------------------------------------------------------
def udev_props(dev):
    props = {}
    try:
        out = subprocess.run(
            ["udevadm", "info", "--query=property", "--name", dev],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return props
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            props[k] = v
    return props


def dof_ports():
    """Ports serie declares dans cabinet.xml (Teensy/Wemos DOF) : a ne pas prendre."""
    ports = set()
    try:
        with open(CABINET_XML, encoding="utf-8", errors="replace") as f:
            ports.update(re.findall(r"<ComPortName>\s*(/dev/\S+?)\s*</ComPortName>", f.read()))
    except OSError:
        pass
    return ports


def detect():
    used = dof_ports()
    found = []
    for dev in sorted(glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*")):
        p = udev_props(dev)
        vid = p.get("ID_VENDOR_ID", "").lower()
        family, label = VID_FAMILY.get(vid, ("unknown", "carte serie inconnue"))
        candidate = family in ("esp32", "bridge") and dev not in used
        found.append({
            "device": dev,
            "vendor_id": vid,
            "product_id": p.get("ID_MODEL_ID", "").lower(),
            "model": p.get("ID_MODEL", "") or p.get("ID_MODEL_FROM_DATABASE", ""),
            "serial": p.get("ID_SERIAL_SHORT", ""),
            "family": family,
            "label": label + (" — declare dans cabinet.xml (DOF)" if dev in used else ""),
            "candidate": candidate,
            "by_id": _by_id_link(dev),
        })
    return found


def _sys_read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return ""


def detect_pin2dmd():
    """PIN2DMD branches (USB brut, pas de port serie) + etat de l'acces pinball."""
    devices = []
    for d in glob.glob("/sys/bus/usb/devices/*"):
        if _sys_read(d + "/idVendor").lower() != PIN2DMD_VID:
            continue
        if _sys_read(d + "/idProduct").lower() != PIN2DMD_PID:
            continue
        try:
            node = "/dev/bus/usb/%03d/%03d" % (int(_sys_read(d + "/busnum")), int(_sys_read(d + "/devnum")))
        except ValueError:
            node = ""
        writable = bool(node) and os.access(node, os.W_OK)
        devices.append({
            "product": _sys_read(d + "/product") or "PIN2DMD",
            "serial": _sys_read(d + "/serial"),
            "node": node,
            "writable": writable,
        })
    return {"devices": devices, "udev_rule": os.path.isfile(PIN2DMD_UDEV_RULE)}


def _by_id_link(dev):
    """Chemin stable /dev/serial/by-id/… (ne change pas avec l'ordre d'enumeration)."""
    real = os.path.realpath(dev)
    for link in glob.glob("/dev/serial/by-id/*"):
        if os.path.realpath(link) == real:
            return link
    return ""


# --- apply -------------------------------------------------------------------
def desired_vpx_values(cfg, current):
    mode = cfg["mode"]
    other_consumers = any(_truthy(current.get(k)) for k in ("pixelcade", "dmdserver"))
    if mode == "off":
        return {
            "Enable": "1" if other_consumers else "0",
            "ZeDMD": "0",
            "ZeDMDWiFiEnabled": "0",
            "ZeDMDDevice": "",
            "ZeDMDWiFiAddr": "",
            "PIN2DMD": "0",
        }
    if mode == "pin2dmd":
        return {
            "Enable": "1",
            "PIN2DMD": "1",
            "ZeDMD": "0",
            "ZeDMDWiFiEnabled": "0",
            "ZeDMDDevice": "",
            "ZeDMDWiFiAddr": "",
        }
    return {
        "Enable": "1",
        "PIN2DMD": "0",
        "ZeDMD": "1",
        "ZeDMDWiFiEnabled": "1" if mode == "wifi" else "0",
        "ZeDMDDevice": cfg["device"] if mode == "usb" else "",
        "ZeDMDWiFiAddr": cfg["wifi_addr"] if mode == "wifi" else "",
        "ZeDMDBrightness": str(cfg["brightness"]) if cfg["brightness"] >= 0 else "",
    }


def desired_vpinfe_values(cfg):
    menu = cfg["mode"] in ("usb", "wifi") and cfg["targets"] == "both"
    if not menu:
        return {"enabled": "false", "zedmddevice": "", "zedmdwifiaddr": ""}
    return {
        "enabled": "true",
        "zedmddevice": cfg["device"] if cfg["mode"] == "usb" else "",
        "zedmdwifiaddr": cfg["wifi_addr"] if cfg["mode"] == "wifi" else "",
    }


def problemes(cfg):
    """(erreurs, avertissements). Un DMD absent est un etat transitoire, pas une erreur."""
    erreurs, avertissements = [], []
    if cfg["mode"] == "wifi" and not re.match(r"^[A-Za-z0-9.\-]+$", cfg["wifi_addr"] or ""):
        erreurs.append("adresse Wi-Fi du ZeDMD manquante ou invalide")
    if cfg["mode"] == "usb" and cfg["device"] and not cfg["device"].startswith("/dev/"):
        erreurs.append("le port USB doit etre un chemin /dev/…")
    if cfg["mode"] == "usb" and cfg["device"] and not os.path.exists(cfg["device"]):
        avertissements.append(f"port ZeDMD configure absent pour le moment : {cfg['device']}")
    if cfg["mode"] == "usb" and not cfg["device"] and not any(d.get("candidate") for d in detect()):
        avertissements.append("aucun port ZeDMD candidat present ; l'auto-detection USB reste active")
    if cfg["mode"] == "pin2dmd" and cfg["targets"] == "both":
        avertissements.append("PIN2DMD : en jeu seulement — la bibliotheque libdmdutil embarquee "
                              "dans VPinFE n'a pas la prise en charge PIN2DMD")
    return erreurs, avertissements


def validate(cfg):
    erreurs, avertissements = problemes(cfg)
    return erreurs + avertissements


def apply(cfg):
    ensure_pinball_serial_access()
    erreurs, avertissements = problemes(cfg)
    if erreurs:
        for e in erreurs:
            print("ERREUR: " + e)
        return 2
    for a in avertissements:
        print("AVERTISSEMENT: " + a)
    # PIN2DMD reste game-only ; ZeDMD USB/Wi-Fi conserve exactement la cible
    # demandee, y compris USB both avec device vide (auto-detection libdmdutil).
    if cfg["mode"] == "pin2dmd" and cfg["targets"] == "both":
        cfg = dict(cfg, targets="game")
        try:
            save_config(cfg)
        except OSError as exc:
            print(f"AVERTISSEMENT: configuration non reecrite ({exc})")
    vpx = vpx_ini_path()
    if vpx:
        with open(vpx, encoding="utf-8", errors="replace") as f:
            text = f.read()
        current = read_section(text, "Plugin.DMDUtil")
        new = update_section(text, "Plugin.DMDUtil", desired_vpx_values(cfg, current))
        if new != text:
            write_atomic(vpx, new)
            print(f"VPX      : [Plugin.DMDUtil] mis a jour ({vpx})")
        else:
            print("VPX      : deja conforme")
    else:
        print("VPX      : VPinballX.ini introuvable (rien ecrit)")
    restart = 0
    if os.path.isfile(VPINFE_INI):
        with open(VPINFE_INI, encoding="utf-8", errors="replace") as f:
            text = f.read()
        new = update_section(text, "libdmdutil", desired_vpinfe_values(cfg))
        if new != text:
            write_atomic(VPINFE_INI, new)
            restart = 1
            print("VPinFE   : [libdmdutil] mis a jour (redemarrage du frontend requis)")
        else:
            print("VPinFE   : deja conforme")
    else:
        print("VPinFE   : vpinfe.ini introuvable (rien ecrit)")
    print(f"RESTART_VPINFE={restart}")
    return 0


# --- status ------------------------------------------------------------------
def status():
    cfg = load_config()
    out = {"config": cfg, "vpx": {}, "vpinfe": {}, "warnings": validate(cfg)}
    vpx = vpx_ini_path()
    if vpx:
        with open(vpx, encoding="utf-8", errors="replace") as f:
            s = read_section(f.read(), "Plugin.DMDUtil")
        out["vpx"] = {
            "ini": vpx,
            "enable": _truthy(s.get("enable")),
            "zedmd": _truthy(s.get("zedmd")),
            "pin2dmd": _truthy(s.get("pin2dmd")),
            "wifi": _truthy(s.get("zedmdwifienabled")),
            "device": s.get("zedmddevice", ""),
            "wifi_addr": s.get("zedmdwifiaddr", ""),
            "brightness": s.get("zedmdbrightness", ""),
        }
    if os.path.isfile(VPINFE_INI):
        with open(VPINFE_INI, encoding="utf-8", errors="replace") as f:
            s = read_section(f.read(), "libdmdutil")
        out["vpinfe"] = {
            "ini": VPINFE_INI,
            "enabled": _truthy(s.get("enabled")),
            "device": s.get("zedmddevice", ""),
            "wifi_addr": s.get("zedmdwifiaddr", ""),
        }
    out["pin2dmd"] = detect_pin2dmd()
    out["test_available"] = (
        cfg["mode"] in ("usb", "wifi")
        and os.path.isfile(os.path.join(VPINFE_DMDUTIL_DIR, "libdmdutil_wrapper.py"))
    )
    return out


def _controller(cfg):
    """Construit le controller ZeDMD sans forcer de transport en mode USB auto."""
    sys.path.insert(0, VPINFE_DMDUTIL_DIR)
    os.environ["LD_LIBRARY_PATH"] = VPINFE_DMDUTIL_DIR + ":" + os.environ.get("LD_LIBRARY_PATH", "")
    from libdmdutil_wrapper import DMDController  # noqa: E402
    kwargs = {"brightness": cfg["brightness"]}
    if cfg["mode"] == "wifi":
        kwargs["host"] = cfg["wifi_addr"]
    elif cfg["device"]:
        kwargs["device"] = cfg["device"]
    return DMDController(**kwargs)


# --- image -------------------------------------------------------------------
def image(chemin, seconds):
    """Affiche une image ajustee a la matrice via le bridge libdmdutil de VPinFE."""
    if not os.path.isfile(chemin):
        print(f"ERREUR: image absente : {chemin}")
        return 2
    cfg = load_config()
    if cfg["mode"] == "off":
        print("ERREUR: DMD LED desactive dans la configuration")
        return 2
    if cfg["mode"] == "pin2dmd":
        print("ERREUR: image indisponible pour le PIN2DMD (bridge VPinFE sans PIN2DMD)")
        return 2
    erreurs, avertissements = problemes(cfg)
    if erreurs:
        for e in erreurs:
            print("ERREUR: " + e)
        return 2
    for a in avertissements:
        print("AVERTISSEMENT: " + a)
    try:
        dmd = _controller(cfg)
        from libdmdutil_wrapper import load_image_frame  # noqa: E402
    except Exception as exc:
        print(f"ERREUR: bridge libdmdutil de VPinFE indisponible ({exc})")
        return 3
    try:
        info = dmd.load()
        print(f"connecte : {info.width}x{info.height} (HD={info.has_hd_display})")
        trame = load_image_frame(chemin, info.width, info.height, fit_mode="contain")
        import time
        deadline = time.time() + max(1, seconds)
        while time.time() < deadline:
            dmd.send_rgb_frame(trame.rgb_bytes)
            time.sleep(0.5)
        dmd.clear()
        print(f"image envoyee ({os.path.basename(chemin)}), ecran efface")
        return 0
    except Exception as exc:
        print(f"ERREUR: {exc}")
        return 1
    finally:
        try:
            dmd.unload()
        except Exception:
            pass


# --- test --------------------------------------------------------------------
def test(seconds):
    cfg = load_config()
    if cfg["mode"] == "off":
        print("ERREUR: DMD LED desactive dans la configuration")
        return 2
    if cfg["mode"] == "pin2dmd":
        print("ERREUR: test indisponible pour le PIN2DMD (bridge VPinFE sans PIN2DMD)")
        return 2
    erreurs, avertissements = problemes(cfg)
    if erreurs:
        for e in erreurs:
            print("ERREUR: " + e)
        return 2
    for a in avertissements:
        print("AVERTISSEMENT: " + a)
    try:
        dmd = _controller(cfg)
        from media import make_test_pattern  # noqa: E402
    except Exception as exc:
        print(f"ERREUR: bridge libdmdutil de VPinFE indisponible ({exc})")
        return 3
    try:
        info = dmd.load()
        print(f"connecte : {info.width}x{info.height} (HD={info.has_hd_display})")
        import time
        deadline = time.time() + max(1, seconds)
        frame = 0
        while time.time() < deadline:
            dmd.send_rgb_frame(make_test_pattern(info.width, info.height, frame))
            frame += 1
            time.sleep(0.1)
        dmd.clear()
        print("mire envoyee, ecran efface")
        return 0
    except Exception as exc:
        print(f"ERREUR: {exc}")
        return 1
    finally:
        try:
            dmd.unload()
        except Exception:
            pass


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "detect":
        print(json.dumps(detect(), indent=2, ensure_ascii=False))
        return 0
    if cmd == "status":
        print(json.dumps(status(), indent=2, ensure_ascii=False))
        return 0
    if cmd == "apply":
        return apply(load_config())
    if cmd == "set":
        try:
            incoming = json.loads(argv[2]) if len(argv) > 2 else json.load(sys.stdin)
        except ValueError as exc:
            print(f"ERREUR: JSON invalide ({exc})")
            return 2
        if not isinstance(incoming, dict):
            print("ERREUR: objet JSON attendu")
            return 2
        cfg = dict(DEFAULTS)
        cfg.update({k: incoming.get(k, v) for k, v in DEFAULTS.items()})
        save_config(cfg)
        cfg = load_config()
        save_config(cfg)
        print("configuration enregistree : " + json.dumps(cfg, ensure_ascii=False))
        return 0
    if cmd == "image":
        if len(argv) < 3:
            print("usage : pincabos-zedmd image <fichier> [secondes]")
            return 2
        try:
            secondes = int(argv[3]) if len(argv) > 3 else 5
        except ValueError:
            secondes = 5
        return image(argv[2], secondes)
    if cmd == "test":
        try:
            seconds = float(argv[2]) if len(argv) > 2 else 4.0
        except ValueError:
            seconds = 4.0
        return test(seconds)
    print(__doc__)
    return 2


