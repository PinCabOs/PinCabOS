# ------------------------------------------------------------
# Copies de sauvegarde - jamais versionnees
# Remplace les anciennes regles, limitees a /opt/pincabos/{script,web}/
# et au seul motif ".bak-" : elles laissaient passer ".bak." ainsi que
# tout le reste de l'arborescence.
# ------------------------------------------------------------
**/*.bak
**/*.bak.*
**/*.bak-*
**/*.before-*
**/*.orig
**/*.old
/opt/pincabos/web/backups/
/home/pinball/.local/share/pincabos/editor-backups/
/home/pinball/.local/share/VPinballX/*/backups/


# Sauvegardes de metadonnees LVM : regenerees par LVM a chaque modification,
# et propres a la machine qui les a ecrites (UUID de disque, taille du SSD).
/etc/lvm/backup/
/etc/lvm/archive/

# ------------------------------------------------------------
# Vidages de plantage : residus propres a la machine qui les a
# ecrits, deja exclus de l'ISO par iso.sh.
# ------------------------------------------------------------
/var/crash/

