[Unit]
Description=PinCabOS Chat BackGlass Agent
# PINCABOS_UNITES_SANS_CYCLE_V1 : jamais « After=graphical.target » dans une
# unite que graphical.target tire lui-meme. On nomme ce qu on attend vraiment :
# la webapp qui sert le contenu, et le frontend qui tient les fenetres.
After=network-online.target pincabos-webapp.service pincabos-vpinfe.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/pincabos-chat-backglass-agent
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
